{
  "name": "word-tour",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:all": "concurrently -n client,server -c cyan,magenta \"npm:dev\" \"npm:dev:server\"",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "generate-levels": "tsx scripts/generate-levels/index.ts",
    "dev:server": "tsx watch server/index.ts",
    "build:server": "tsc -p tsconfig.server.json",
    "start": "node dist/server/index.js",
    "typecheck:server": "tsc --noEmit -p tsconfig.server.json"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.9.0",
    "@types/ws": "^8.18.1",
    "concurrently": "^10.0.5",
    "jsdom": "^25.0.1",
    "subtlex-word-frequencies": "^2.0.0",
    "tsx": "^4.23.14",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.4",
    "word-list": "^4.1.0"
  },
  "dependencies": {
    "dotenv": "^18.0.1",
    "express": "^5.2.1",
    "tiktok-live-connector": "^2.5.0",
    "ws": "^8.21.3",
    "zod": "^4.6.5"
  }
}
